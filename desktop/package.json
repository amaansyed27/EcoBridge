{
  "name": "ecobridge-desktop",
  "version": "1.0.0",
  "description": "EcoBridge Desktop - Universal ecosystem bridge",
  "main": "src/electron/main.ts",
  "scripts": {
    "dev": "concurrently \"npm run dev:next\" \"npm run dev:electron\" \"npm run dev:socket\"",
    "dev:next": "next dev",
    "dev:electron": "wait-on http://localhost:3000 && electron -r ts-node/register .",
    "dev:socket": "ts-node socket_server.ts",
    "build": "next build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "package": "electron-builder"
  },
  "keywords": [
    "ecobridge",
    "continuity",
    "ecosystem"
  ],
  "author": "AcWoC 2026",
  "license": "MIT",
  "dependencies": {
    "bonjour-service": "^1.1.1",
    "clipboardy": "^5.1.0",
    "crypto-js": "^4.2.0",
    "electron-is-dev": "^2.0.0",
    "express": "^5.2.1",
    "loudness": "^0.4.2",
    "next": "^14.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shelljs": "^0.10.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "systeminformation": "^5.30.6",
    "ts-node": "^10.9.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@types/shelljs": "^0.10.0",
    "@types/socket.io": "^3.0.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "type": "commonjs"
}
